{
  "name": "Jarvis Android & Server Environment",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    },
    "ghcr.io/casl0/devcontainer-features/android-sdk:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-node-azurepack",
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "postCreateCommand": "cd android && chmod +x gradlew"
}
